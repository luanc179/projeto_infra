# Copie este arquivo para .env e troque TODAS as senhas. O .env NÃO deve ser versionado.

# --- Banco de dados (MariaDB) ---
MYSQL_ROOT_PASSWORD=zabbix
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=zabbix

# --- Fuso horário ---
TZ=America/Manaus

# --- Zabbix (usuário da interface/API) ---
# O Zabbix recém-instalado vem com Admin / zabbix. Troque a senha na interface
ZABBIX_ADMIN_USER=Admin
ZABBIX_ADMIN_PASSWORD=zabbix

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_VERSION=13.2.3

# --- Portas publicadas no host pelo Nginx ---
NGINX_ZABBIX_PORT=8080
NGINX_GRAFANA_PORT=3000

# --- Usados pelos scripts Python (rodam no host, fora dos contêineres) ---
ZABBIX_WEB_URL=http://localhost:8080
ZABBIX_SERVER_HOST=127.0.0.1
ZABBIX_SERVER_PORT=10051
